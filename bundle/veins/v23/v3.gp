\\ v3.gp -- BAR-V23 vein 3: unit index of the group generated by the conjugates of b_1 (p = 7 mod 8).
\\ GRH: bnfinit results are conditional on GRH unless bnfcertify returns 1 (reported).
read("veins/v4_fast/fastmin.gp");
DIR = "veins/v23/";

\\ exponent matrix (columns = elements) w.r.t. the fundamental units; torsion dropped
expmat(bnf, els) = {
  my(r = #bnf.fu, V = vector(#els, i, my(v = bnfisunit(bnf, els[i])); if(#v == 0, error("not a unit")); v));
  matrix(r, #els, i, j, V[j][i]);
}
idxinfo(M) = {
  my(H = mathnf(M), r = #M[,1], rk = #H, Sq, d, nz);
  Sq = if(rk == r, H, matconcat([H, matrix(r, r - rk)]));
  d = matsnf(Sq); nz = select(x -> x != 0, d);
  [rk, vecprod(nz), d];
}

\\ G = minimal polynomial of b_1; returns [bnf, roots of G in the field]
fieldsetup(G, label) = {
  my(t0 = getabstime(), P = subst(polredbest(G), 'x, 'y), bnf, rts);
  print("  ", label, ": polredbest degree ", poldegree(P), ", signature ", polsturm(P), " real roots; ", (getabstime()-t0)\1000, " s");
  bnf = bnfinit(P, 1);
  print("  bnfinit done ", (getabstime()-t0)\1000, " s: h = ", bnf.no, ", class group ", bnf.cyc, ", unit rank ", #bnf.fu,
        ", torsion w = ", bnf.tu[1], ", regulator ", Strprintf("%.10g", bnf.reg));
  rts = nfroots(bnf, G);
  print("  roots of G_p in this field: ", #rts, "  (", (getabstime()-t0)\1000, " s)");
  [bnf, rts, P];
}

report(bnf, rts, label) = {
  my(M = expmat(bnf, rts), I1 = idxinfo(M), I2 = idxinfo(2 * M), r = #bnf.fu);
  print("  ", label, ": rank of <-1, conjugates> = ", I1[1], " of unit rank ", r, if(I1[1] == r, "  (FULL)", "  (NOT full)"));
  print("    ", if(I1[1] == r, "index [O^* : <torsion, conjugates>] = ", "index in its saturation = "), I1[2], " = ", factor(I1[2]));
  print("    elementary divisors ", I1[3]);
  print("    null (squares): index ", I2[2], ", ratio ", I2[2] / I1[2], " (want 2^", I1[1], " = ", 2^I1[1], ")");
  print("    h = ", bnf.no, ",  index / h = ", I1[2] / bnf.no, " = ", factor(I1[2] / bnf.no));
  I1;
}
