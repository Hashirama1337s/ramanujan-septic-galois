\\ minexp.gp -- smallest E >= 1 with b_1^E in the group generated by -1, 2, p and ALL s_j = 2 sin(pi j/N), 1 <= j < N/2.
\\ Method: integer kernel of the log-embedding matrix (LLL), E_min = gcd of the b_1-coefficients over the kernel;
\\ then the relation with coefficient E_min is verified EXACTLY in Q(theta) (on squares; signs from positivity).
default(realprecision, 1600);
read("cert.gp");

minexp(p, N, E, A, B, C) = {
  my(Jm, Pt = fieldpol(N), R, rts, c1, V, dbest = +oo, rowsA = [], n, M, t, Cs = 10^700, L, K, H, ker = List(), tc, Emin, u, rel, lhs, rhs, ok, t0 = getabstime());
  V = real(conjs(p, 1)[1]);
  R = 2^A * p^B * prod(j = 1, #C, Sa(j, Pt)^(C[j]/2));
  rts = if(E == 1, [R], nfroots(Pt, 'x^E - lift(R)));
  for(i = 1, #rts, my(z = Mod(lift(rts[i]), Pt), dd = abs(emb(z, N, 1) - V[1])); if(dd < dbest, dbest = dd; c1 = z));
  for(a = 1, N \ 2, if(gcd(a, N) == 1, rowsA = concat(rowsA, a)));
  Jm = if(N % 2, (N-1)/2, N/2 - 1); n = 2 + Jm;                         \\ generators: 2, p, s_1..s_{N/2-1}
  M = matrix(#rowsA, n + 1, r, c, my(a = rowsA[r]);
        if(c == 1, log(2), if(c == 2, log(p), if(c <= n, log(abs(2 * sin(Pi * a * (c - 2) / N))), -log(abs(emb(c1, N, a)))))));
  L = matconcat([matid(n + 1); round(Cs * M)]);
  K = qflll(L);
  for(i = 1, #K, my(v = L * K[, i]); if(vecmax(abs(v[n + 2 .. #v])) < 10^10, listput(ker, v[1 .. n + 1])));
  ker = Mat(Vec(ker));
  tc = ker[n + 1, ];
  Emin = content(tc);
  print("p = ", p, ": kernel rank ", #ker, " (expected ", n + 1 - matrank(M), "?), b_1-coefficients ", tc, " -> E_min = ", Emin);
  \\ combination with b_1-coefficient Emin
  u = matsolvemod(Mat(tc), 0, Emin);         \\ integer u with tc*u = Emin
  if(type(u) != "t_COL", u = (matsolvemod(Mat(tc), 0, Emin))[1]);
  rel = ker * u;
  if(rel[n + 1] < 0, rel = -rel);
  \\ M*rel = 0 means E log b = sum rel_j log g_j  with the sign convention of column n+1 (= -log b): rel[n+1]*(-log b) + sum rel_j log g_j = 0
  \\ so b^E = prod g_j^{rel_j}.
  lhs = c1^(2 * rel[n + 1]);
  rhs = Mod(4, Pt)^rel[1] * Mod(p^2, Pt)^rel[2] * prod(j = 1, Jm, Sa(j, Pt)^rel[j + 2]);
  ok = (lhs == rhs);
  print("   EXACT check (b_1^E)^2 = 2^(2a) p^(2b) prod S_j^n_j in Q(theta): ", ok, "; numerical residual 10^-",
        dig(rel[n + 1] * log(V[1]) - rel[1] * log(2) - rel[2] * log(p) - sum(j = 1, Jm, rel[j + 2] * log(2 * sin(Pi * j / N)))),
        "  [", (getabstime() - t0) \ 1000, " s]");
  print("   b_1^", rel[n + 1], " = 2^", rel[1], " * ", p, "^", rel[2], " * prod_j (2 sin(pi j/", N, "))^n_j, nonzero n_j: ",
        vector(Jm, j, rel[j + 2]));
  rel;
}
r5 = minexp(5, 20, 2, 5, 0, [-2, 4, -4]);
r7 = minexp(7, 7, 1, 0, 3, [-10, -8]);
r13 = minexp(13, 52, 6, 39, 7, [-6, 50, -24, -40, -30, -8, -12, -44, -18, -58, -36]);
e37 = [4,-62,48,12,-60,48,-64,46,-16,174,40,-70,68,152,20,-74,52,2,8,-28,-28,80,-32,58,12,130,-44,-146,56,174,24,22,36,110,72];
r37 = minexp(37, 148, 4, 74, -5, -e37);
quit
